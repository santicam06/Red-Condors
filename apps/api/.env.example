# Copy to .env to override defaults (or set in Vercel Project Settings). Never commit secrets.
RC_ENV=development
RC_API_PREFIX=/api

# Safe routing — local path or HTTPS/COG URL to the MOLA DEM (falls back to bundled 16 ppd Olympus MOLA grid if absent)
# RC_MOLA_DEM_PATH=data/mola128_mola64_merge_90Nto90S_SimpleC_clon0.tif
# RC_ROUTE_MAX_SLOPE_DEG=15
# RC_ROUTE_SOURCE_MAX_DISTANCE_M=800000
# RC_ROUTE_GRAPH_RADIUS_M=25000
# RC_ROUTE_GRAPH_MAX_SIDE_PX=400
# RC_ROUTE_AREA_MARGIN_FRACTION=0.25
# RC_ROVER_SPEED_KMH=10
# RC_EVA_SPEED_KMH=3.5

# Rover Street View — panorama cache directory (automatically uses /tmp on Vercel)
# RC_ROVER_IMAGES_CACHE_DIR=
